# Copy to .env.deploy and fill every value. Do not commit .env.deploy.
BACKEND_IMAGE=ghcr.io/mohgtheomen/attendance_app-backend:latest
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://attendance:replace-with-a-strong-password@postgres:5432/attendance
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=["https://mohgtheomen.github.io"]
NGROK_URL=https://replace-with-your-domain.ngrok-free.dev
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken
