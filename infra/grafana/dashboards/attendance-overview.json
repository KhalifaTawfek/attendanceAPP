      "targets": [
        {
          "rawSql": "SELECT u.full_name AS user, u.email, count(*) AS submissions, sum(CASE WHEN a.is_late THEN 1 ELSE 0 END) AS late FROM attendances a JOIN users u ON u.id = a.user_id WHERE $__timeFilter(a.submitted_at) GROUP BY u.id ORDER BY submissions DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
