    {
      "id": 21,
      "title": "Turnout per event",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "rawSql": "SELECT e.title AS event, e.starts_at AS starts, count(a.id) AS submissions, coalesce((SELECT string_agg(g.name, ', ') FROM event_groups eg JOIN groups g ON g.id = eg.group_id WHERE eg.event_id = e.id), 'Everyone') AS audience, (CASE WHEN EXISTS (SELECT 1 FROM event_groups eg WHERE eg.event_id = e.id) THEN (SELECT count(DISTINCT u.id) FROM users u JOIN group_members gm ON gm.user_id = u.id JOIN event_groups eg ON eg.group_id = gm.group_id WHERE eg.event_id = e.id AND u.is_active AND u.role = 'user') ELSE (SELECT count(*) FROM users WHERE is_active AND role = 'user') END) AS expected, round(100.0 * count(a.id) / nullif((CASE WHEN EXISTS (SELECT 1 FROM event_groups eg WHERE eg.event_id = e.id) THEN (SELECT count(DISTINCT u.id) FROM users u JOIN group_members gm ON gm.user_id = u.id JOIN event_groups eg ON eg.group_id = gm.group_id WHERE eg.event_id = e.id AND u.is_active AND u.role = 'user') ELSE (SELECT count(*) FROM users WHERE is_active AND role = 'user') END), 0), 1) AS turnout_pct, sum(CASE WHEN a.status = 'approved' THEN 1 ELSE 0 END) AS approved, sum(CASE WHEN a.status = 'pending' THEN 1 ELSE 0 END) AS pending, sum(CASE WHEN a.status = 'rejected' THEN 1 ELSE 0 END) AS rejected, sum(CASE WHEN a.is_late THEN 1 ELSE 0 END) AS late FROM events e LEFT JOIN attendances a ON a.event_id = e.id WHERE $__timeFilter(e.starts_at) GROUP BY e.id ORDER BY e.starts_at DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-pg"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "title": "Most frequent attendees (range)",
